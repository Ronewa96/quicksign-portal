# Copy this file to .env and fill in the values you need.

# GEMINI_API_KEY: turns on real AI summaries and Q&A (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: optional, the Gemini model to try first. GEMINI_FALLBACK_MODEL is tried if that one is busy or out of quota.
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# LOCATION_LOOKUP: signer locations are optional. Place names come from OpenStreetMap (coordinates are sent
# to it). Set to "off" to keep coordinates only.
# LOCATION_LOOKUP="off"

# APP_URL: the public address of QuickSign, used for signing links in emails.
# Leave as-is locally; set to e.g. https://sign.yourcompany.com when online.
APP_URL="MY_APP_URL"

# Email (SMTP). Without these, emails are saved to data/outbox instead of being sent.
# Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_USER="you@gmail.com"  SMTP_PASS="your-16-character-app-password"
# Brevo (free 300 emails/day): SMTP_HOST="smtp-relay.brevo.com"  SMTP_PORT="587"  SMTP_USER/SMTP_PASS from Brevo > SMTP & API
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Name and address emails come from, e.g. "QuickSign <you@gmail.com>" (defaults to SMTP_USER)
MAIL_FROM=""
